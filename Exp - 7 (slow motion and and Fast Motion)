        "\n",
        "fourcc = cv2.VideoWriter_fourcc(*'mp4v')\n",
        "\n",
        "fast_video = cv2.VideoWriter(\n",
        "    'fast_motion.mp4',\n",
        "    fourcc,\n",
        "    fps,\n",
        "    (width, height)\n",
        ")\n",
        "\n",
        "frame_count = 0\n",
        "\n",
        "while True:\n",
        "    ret, frame = cap.read()\n",
        "\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    # Write every second frame\n",
        "    if frame_count % 2 == 0:\n",
        "        fast_video.write(frame)\n",
        "\n",
        "    frame_count += 1\n",
        "\n",
        "cap.release()\n",
        "fast_video.release()\n",
        "\n",
        "print(\"Fast-motion video created\")\n"
